{
  "name": "@esco-trade/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "fastify": "^4.27.0",
    "@fastify/autoload": "^5.10.0",
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/helmet": "^10.0.0",
    "@fastify/swagger": "^8.13.0",
    "@fastify/swagger-ui": "^3.0.0",
    "prisma": "^5.14.0",
    "@prisma/client": "^5.14.0",
    "zod": "^3.23.0",
    "decimal.js": "^10.4.0",
    "pino": "^9.0.0",
    "ioredis": "^5.3.2",
    "bullmq": "^5.1.0",
    "ws": "^8.17.0",
    "@esco-trade/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.11.0",
    "vitest": "^1.6.0",
    "supertest": "^6.3.0",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "@types/ws": "^8.5.10"
  }
}
