# Esco Trade — environment placeholders
# Copy to .env and fill in values. Never commit real secrets.

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esco_trade?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
AUTH_SECRET=dev-secret-change-in-production

# ---- Real-Time Market Data Gateway ----
# Active adapter: demo | finnhub | alpaca | polling
MARKET_DATA_PROVIDER=demo

# Finnhub Free Tier (max 50 symbols, 1 WS connection, 60 req/min REST)
FINNHUB_API_KEY=

# Alpaca Market Data Basic Plan (max 30 symbols, 1 WS connection, IEX only)
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Gateway Configuration
MAX_STREAMED_SYMBOLS=50
MARKET_DATA_UPDATE_BATCH_MS=50
MARKET_DATA_RECONNECT_BASE_MS=1000
MARKET_DATA_STALE_AFTER_MS=15000
ALLOW_PUBLIC_LIVE_DATA=false

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=dev-session-secret-change-in-production

# ---- Node ----
NODE_ENV=development
