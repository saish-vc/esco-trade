# Esco Trade — environment placeholders
# Copy to .env and fill in values. Never commit real secrets.

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esco_trade?schema=public

# ---- Auth ----
# If using Auth.js / Better Auth, set the provider secrets below when chosen.
AUTH_SECRET=
# Example (replace with your provider's requirement when chosen):
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ---- Market data: Alpha Vantage (real adapter) ----
# Free tier: https://www.alphavantage.co/support/#api-key
# Live-data redistribution is DISABLED until licensing is verified (see docs/DATA_LICENSING.md).
ALPHA_VANTAGE_API_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=

# ---- Node ----
NODE_ENV=development
